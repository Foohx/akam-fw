#!/usr/bin/env bash
# akam: guided setup for Akam on the LSC Smart Indoor 1080p camera (this PC side).
# Run ./akam help. All logic lives in tools/wizard/lib/*.sh; this file only dispatches.
set -euo pipefail

AKAM_WIZARD_VERSION=${AKAM_WIZARD_VERSION:-1.0.0-dev}
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=tools/lib/host.sh
. "$ROOT/tools/lib/host.sh"
# shellcheck source=tools/wizard/lib/log.sh
. "$ROOT/tools/wizard/lib/log.sh"
# shellcheck source=tools/wizard/lib/state.sh
. "$ROOT/tools/wizard/lib/state.sh"
# shellcheck source=tools/wizard/lib/ui.sh
. "$ROOT/tools/wizard/lib/ui.sh"
# shellcheck source=tools/wizard/lib/tui.sh
. "$ROOT/tools/wizard/lib/tui.sh"
# shellcheck source=tools/wizard/lib/steps_host.sh
. "$ROOT/tools/wizard/lib/steps_host.sh"
# shellcheck source=tools/wizard/lib/cameras.sh
. "$ROOT/tools/wizard/lib/cameras.sh"
# shellcheck source=tools/wizard/lib/camsh.sh
. "$ROOT/tools/wizard/lib/camsh.sh"
# shellcheck source=tools/wizard/lib/transfer.sh
. "$ROOT/tools/wizard/lib/transfer.sh"
# shellcheck source=tools/wizard/lib/steps_camera.sh
. "$ROOT/tools/wizard/lib/steps_camera.sh"
# shellcheck source=tools/wizard/lib/tui_menu.sh
. "$ROOT/tools/wizard/lib/tui_menu.sh"

# Never leak secrets through shell tracing.
set +x

usage() {
    cat <<'EOF'
akam - guided setup for Akam (PC side)

Usage: ./akam [options] [command]

Commands:
  (none)             step menu with status; resumes where you stopped
                     (on a terminal: a full-screen menu, keys: arrows or j/k, Enter, ? help, q)
  doctor             check this computer (tools); changes nothing
  get-kit            download and verify the prebuilt kit (no compiling)
  build              build from source instead (optional, needs more tools)
  prepare-backup-sd  prepare the microSD card used to back up the camera
  find-camera        find the camera (asks its IP address, checks the ports)
  backup             back up the camera (double read, checked, copied to ~/akam-backup-<name>-<date>/),
                     or accept a backup folder you made by hand (--backup-dir DIR)
  image              build the Akam image from your backup
  prepare-flash-sd   prepare the microSD card used to flash the camera
  flash              write the image to the camera (SSH when Akam runs, else maintenance telnet)
  verify             check SSH, ports and hardware, then the same without the card
  update             flash a new image over SSH (no card)
  hostname [NAME]    give the camera its network name (default: the camera's name), over SSH;
                     applied at the next power cycle (needs a firmware that has akam_hostname.sh)
  rtsp-auth [set|disable|status]
                     password (Digest login) on the video stream, over SSH; off by default
                     (typed here, never shown, sent to the camera only as a hash); default: status
  led [show | status on|off|auto] [ir auto|off]
                     the front LED and the infrared night LEDs, over SSH; saved on the camera. Default: show.
                       status: on (as now), off, or auto (blinks while starting or without Wi-Fi, blinks
                       slowly while someone watches the video, solid otherwise)
                       ir: auto (IR LEDs light at night) or off (never lit; night mode still switches the image)
  talk [SECONDS | test]
                     speak to the camera's speaker from this computer's microphone (Ctrl-C stops);
                     'test' sends a 2 second tone. Needs the stream password (rtsp-auth) and
                     ffmpeg or arecord; uses the ONVIF audio backchannel on port 554
  say FILE           play an audio file on the camera's speaker (ffmpeg converts it)
  restore            put the original APP back from your backup
  wipe-sd            erase a card that holds your Wi-Fi password (use it when you are done)
  step NAME          run one step again (doctor, get-kit, prepare-backup-sd,
                     find-camera, backup, image, prepare-flash-sd, flash, verify)
  status             show every step: done / todo / blocked
  cameras            list the cameras you set up (one progress each); switch with --camera NAME
  rename-camera NEW  give the current camera another name (its progress moves with it)
  register           record a camera that ALREADY runs Akam, without redoing backup, image or flash:
                     ./akam --camera NAME --ip ADDRESS [--backup-dir DIR] register
  help               this text

Options:
  --dry-run          rehearse: show every command, change nothing, ask nothing
  --kit FILE         use a local kit (tarball with SHA256SUMS next to it, or folder)
  --version X.Y.Z    release to download for get-kit
  --allow-unsigned   accept a kit without a signature (checksum only)
  --expect-sha256 H  require the kit sha256 to start with H (from the release notes)
  --backup-dir DIR   your backup folder (mtdblock0.bin ... mtdblock7.bin)
  --backup-copy DIR  also copy the backup folder to DIR (another medium) and check the copy
  --ip ADDRESS       the camera's IP address (find-camera asks otherwise)
  --identity FILE    your SSH private key (default: ~/.ssh/akam, or --pubkey without .pub)
  --image FILE       image for update (default: the one built by the image step)
  --manual-telnet    never drive the camera's telnet shell: the wizard prints each command and
                     you paste it in your own telnet window (also automatic after 2 failures)
  --out DIR          where the image is written (default ~/akam-image-<name>-<date>)
  --comp xz|gzip     override the stock APP compression (not recommended)
  --allow-unknown-stock-comp
                     allow a stock APP compression other than xz/gzip (expert)
  --device DEV       whole microSD disk, for example /dev/sdb
  --pubkey FILE      SSH public key for the flash card (default ~/.ssh/akam.pub)
  --ssid NAME        Wi-Fi name (the password is asked without echo, or set AKAM_WIFI_PASS)
  --profile P        doctor profile: kit | build | all
  --camera NAME      the camera to work on (a short name such as salon: a-z, 0-9, '-', at most 20).
                     Each camera has its own progress and log; a new name starts a new camera. The
                     name is used in the backup and image folders. The first menu run asks for it;
                     progress made before this existed is the camera called "default".
  --state-dir DIR    where progress and the logs are kept
                     (default ${XDG_STATE_HOME:-~/.local/state}/akam)
  --no-color         no colours (NO_COLOR works too)
  --plain            line-based output and prompts, no full-screen menu or widgets
                     (also automatic when not on a terminal; AKAM_PLAIN=1 does the same)

Safety: the wizard itself never runs sudo (it prints the command; only the SD tool asks sudo
for the disk work), shows every command before it runs, refuses destructive actions without a
terminal, and never stores your Wi-Fi password. Erasing a card and writing the camera's flash
each need your explicit yes in a red box (one yes/no, default No: Enter, Esc or q mean No).
It never reboots or power-cycles the camera.
EOF
}

OPT_KIT="" OPT_VERSION="" OPT_ALLOW_UNSIGNED="" OPT_EXPECT_SHA256="" OPT_BACKUP_DIR=""
OPT_OUT="" OPT_COMP="" OPT_ALLOW_UNKNOWN_COMP="" OPT_DEVICE="" OPT_PUBKEY="" OPT_SSID=""
OPT_PROFILE="" OPT_BUILD=0
OPT_CAMERA="" OPT_IP="" OPT_IDENTITY="" OPT_IMAGE="" OPT_BACKUP_COPY="" OPT_MANUAL_TELNET=0 OPT_PLAIN=0
DRY=0
STATE_OVERRIDE=""
ARGS=()
need_val() { [ "$2" -ge 2 ] || { echo "akam: $1 needs a value (see ./akam help)" >&2; exit 2; }; }
while [ $# -gt 0 ]; do
    case $1 in
        --dry-run) DRY=1 ;;
        --no-color) export NO_COLOR=1 ;;
        --plain) OPT_PLAIN=1 ;;
        --allow-unsigned) OPT_ALLOW_UNSIGNED=1 ;;
        --allow-unknown-stock-comp) OPT_ALLOW_UNKNOWN_COMP=1 ;;
        --kit) need_val "$1" $#; OPT_KIT=$2; shift ;;
        --version) need_val "$1" $#; OPT_VERSION=$2; shift ;;
        --expect-sha256) need_val "$1" $#; OPT_EXPECT_SHA256=$2; shift ;;
        --backup-dir) need_val "$1" $#; OPT_BACKUP_DIR=$2; shift ;;
        --backup-copy) need_val "$1" $#; OPT_BACKUP_COPY=$2; shift ;;
        --ip) need_val "$1" $#; OPT_IP=$2; shift ;;
        --identity) need_val "$1" $#; OPT_IDENTITY=$2; shift ;;
        --image) need_val "$1" $#; OPT_IMAGE=$2; shift ;;
        --manual-telnet) OPT_MANUAL_TELNET=1 ;;
        --out) need_val "$1" $#; OPT_OUT=$2; shift ;;
        --comp) need_val "$1" $#; OPT_COMP=$2; shift ;;
        --device) need_val "$1" $#; OPT_DEVICE=$2; shift ;;
        --pubkey) need_val "$1" $#; OPT_PUBKEY=$2; shift ;;
        --ssid) need_val "$1" $#; OPT_SSID=$2; shift ;;
        --profile) need_val "$1" $#; OPT_PROFILE=$2; shift ;;
        --state-dir) need_val "$1" $#; STATE_OVERRIDE=$2; shift ;;
        --camera)
            need_val "$1" $#
            if [ -z "$2" ]; then echo "akam: --camera needs a short name (see ./akam help)" >&2; exit 2; fi
            OPT_CAMERA=$2
            shift
            ;;
        -h | --help) ARGS+=(help) ;;
        -*) echo "akam: unknown option $1 (see ./akam help)" >&2; exit 2 ;;
        *) ARGS+=("$1") ;;
    esac
    shift
done
CMD=${ARGS[0]:-}
case $CMD in
    help)
        usage
        exit 0
        ;;
esac
case $OPT_COMP in "" | xz | gzip) ;; *) echo "akam: --comp must be xz or gzip" >&2; exit 2 ;; esac

UI_DRY=$DRY
tui_init "$OPT_PLAIN"
if [ -n "$OPT_CAMERA" ] && ! cams_name_valid "$OPT_CAMERA"; then
    echo "akam: --camera needs a short name: lowercase letters, digits and '-', at most $CAM_NAME_MAX, not starting or ending with '-'" >&2
    exit 2
fi
cams_init "${STATE_OVERRIDE:-$(state_default_dir)}" "$OPT_CAMERA"
# The very first run of the menu asks for the camera's name before any state exists.
CAMS_ASKED=0
if [ -z "$CMD" ]; then
    if cams_first_run_name || cams_first_run_legacy; then CAMS_ASKED=1; fi
fi
cams_open
if [ -n "$OPT_CAMERA" ] || [ "$CAMS_ASKED" = 1 ]; then cams_remember "$CAM_NAME"; fi
# The Wi-Fi settings are read once from the environment and removed from it, so that no tool
# started by the wizard inherits them (only the SD tool gets them, explicitly).
ENV_WIFI_SSID=${AKAM_WIFI_SSID:-${AKAM_SD_SSID:-}}
ENV_WIFI_PASS=${AKAM_WIFI_PASS:-${AKAM_SD_PASS:-}}
unset AKAM_WIFI_SSID AKAM_WIFI_PASS AKAM_SD_SSID AKAM_SD_PASS
log_add_secret "$ENV_WIFI_PASS"
state_set wizard_version "$AKAM_WIZARD_VERSION"
log_line "START akam ${CMD:-menu} dry=$DRY"
if [ "$DRY" = 1 ]; then
    ui_say "REHEARSAL (--dry-run): commands are shown, nothing is changed."
    # A new full rehearsal starts from scratch; single-step rehearsals continue the previous one.
    if [ -z "$CMD" ]; then state_reset_dry; fi
fi

rc=0
# ./akam --camera NAME --ip ADDRESS on a camera without progress: offer to record it as already installed.
if [ -z "$CMD" ] && [ -n "$OPT_CAMERA" ] && [ -n "$OPT_IP" ] && [ "$DRY" != 1 ] && [ -z "$(state_get camera_kind)" ] && host_is_tty; then
    if ui_ask_yn "Camera '$CAM_NAME' has no progress yet. Is it a camera that ALREADY runs Akam at $OPT_IP (register it, no backup or flash)?"; then
        cmd_register || rc=$?
    fi
fi
case $CMD in
    "")
        if [ "$TUI_ON" = 1 ]; then
            tui_main_menu || rc=$?
        elif [ "$DRY" = 1 ]; then
            wizard_walk || rc=$?
        elif host_is_tty; then
            wizard_menu || rc=$?
        else
            status_table
            ui_blank
            ui_say "No terminal attached: showing status only. Run ./akam in a terminal to continue."
        fi
        ;;
    status) status_table ;;
    cameras) cmd_cameras ;;
    rename-camera)
        if [ -z "${ARGS[1]:-}" ]; then echo "akam: rename-camera needs the new name" >&2; exit 2; fi
        cmd_rename_camera "${ARGS[1]}" || rc=$?
        ;;
    register) cmd_register || rc=$? ;;
    doctor) cmd_doctor || rc=$? ;;
    get-kit) cmd_get_kit || rc=$? ;;
    build) cmd_build || rc=$? ;;
    prepare-backup-sd) cmd_prepare_backup_sd || rc=$? ;;
    backup) cmd_backup || rc=$? ;;
    image) cmd_image || rc=$? ;;
    prepare-flash-sd) cmd_prepare_flash_sd || rc=$? ;;
    wipe-sd) cmd_wipe_sd || rc=$? ;;
    find-camera) cmd_find_camera || rc=$? ;;
    flash) cmd_flash || rc=$? ;;
    verify) cmd_verify || rc=$? ;;
    update) cmd_update || rc=$? ;;
    hostname) cmd_hostname "${ARGS[1]:-}" || rc=$? ;;
    rtsp-auth) cmd_rtsp_auth "${ARGS[1]:-status}" || rc=$? ;;
    led)
        cmd_led ${ARGS[@]+"${ARGS[@]:1}"} || rc=$?
        ;;
    talk) cmd_talk ${ARGS[@]+"${ARGS[@]:1}"} || rc=$? ;;
    say) cmd_say ${ARGS[@]+"${ARGS[@]:1}"} || rc=$? ;;
    restore) cmd_restore || rc=$? ;;
    step)
        if [ "${#ARGS[@]}" -lt 2 ] || ! step_valid_name "${ARGS[1]}"; then
            echo "akam: step needs a name: $WIZ_STEPS" >&2
            exit 2
        fi
        step_run "${ARGS[1]}" || rc=$?
        ;;
    *)
        echo "akam: unknown command '$CMD' (see ./akam help)" >&2
        exit 2
        ;;
esac
log_line "END rc=$rc"
exit "$rc"
