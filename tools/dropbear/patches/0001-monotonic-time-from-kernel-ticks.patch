+#if defined(__linux__) && defined(__arm__)
+/* Camyn: on the Anyka AK3918 (Linux 4.4, ARM926, no clock_gettime64 syscall,
+ * Zig's musl 1.2 with a 64-bit time_t) the clock_gettime() result was
+ * unusable on the camera: sessions were dropped with "Timeout before auth"
+ * in the same second. Dropbear only needs second-resolution monotonic time
+ * for its timeouts, so take it from the kernel tick counter instead: the raw
+ * times(2) syscall returns the 32-bit jiffies count, with no struct and no
+ * time_t width involved. It is accumulated into 64 bits (wrap safe) and
+ * starts above zero, because Dropbear treats a 0 timestamp as "unset". */
+static int camyn_ticks_now(struct timespec *now) {
+	static uint32_t last_ticks;
+	static uint64_t total_ticks;
+	static long hz;
+	register long r7 __asm__("r7") = 43; /* __NR_times */
+	register long r0 __asm__("r0") = 0;  /* NULL struct tms */
+	uint32_t ticks;
+
+	if (hz <= 0) {
+		hz = sysconf(_SC_CLK_TCK);
+		if (hz <= 0 || hz > 1000) {
+			hz = 0;
+			return -1;
+		}
+	}
+	__asm__ volatile ("svc 0" : "+r"(r0) : "r"(r7) : "memory");
+	ticks = (uint32_t)r0;
+	if (total_ticks == 0) {
+		total_ticks = (uint64_t)ticks + (uint64_t)hz;
+	} else {
+		total_ticks += (uint32_t)(ticks - last_ticks);
+	}
+	last_ticks = ticks;
+	now->tv_sec = (time_t)(total_ticks / (uint64_t)hz);
+	now->tv_nsec = (long)((total_ticks % (uint64_t)hz) * (1000000000UL / (unsigned long)hz));
+	return 0;
+}
+#endif
