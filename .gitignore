# ak_rtsp build versioning (regenerated every `make`)
/platforms/anyka-ak3918/build_number.txt
/platforms/anyka-ak3918/version_info.h

# Local SmolRTSP checkout & firmware build workspace (see README prerequisites)
# NOTE: smolrtsp must live at third_party/smolrtsp --
# the platform Makefiles name it as ../../third_party/smolrtsp.
/third_party/smolrtsp
/firmware/lsc-indoor-1080p-ak3918/image/app_extracted/
/firmware/lsc-indoor-1080p-ak3918/image/app_patched/
/firmware/lsc-indoor-1080p-ak3918/image/new_app_gzip.squashfs
# build_image.sh outputs when FW_DIR is the default (they quote the stock service.sh)
/firmware/lsc-indoor-1080p-ak3918/image/service_sh.diff
/firmware/lsc-indoor-1080p-ak3918/image/build_report.txt
/firmware/lsc-indoor-1080p-ak3918/image/audit_remote_services.txt
/firmware/lsc-indoor-1080p-ak3918/image/ak_rtsp_firmware_*

# Go assistant (tools/assistant): go.mod is not a Fortran module file; the build output bin/ stays ignored
!/tools/assistant/go.mod
/tools/assistant/bin/

# OS Specific
.DS_Store
Thumbs.db

# Native build: pinned toolchain/download cache and build outputs
/tools/.toolchain
/tools/.cache/
/build/
/dist/
/platforms/anyka-ak3918/*.o
/platforms/anyka-ak3918/isp_hook.so
/platforms/anyka-ak3918/isp_dump
/firmware/lsc-indoor-1080p-ak3918/image/new_app_*.squashfs

# Synthetic test fixtures must stay tracked despite the bin/, *.bin and
# *.squashfs rules above (keep this negation last).
!/tests/fixtures/**
/platforms/anyka-ak3918/ak_rtsp.repro

# Real camera frames of the drift matcher test (never committed; the test skips its real-frame part without them).
# After the tests/fixtures negation above on purpose: the last matching rule wins.
/tests/fixtures/drift/
